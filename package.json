{
  "name": "sz-project-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:connect": "node --env-file-if-exists=.env.local scripts/connect-db.mjs",
    "catalog:fetch": "node --conditions=react-server --import tsx scripts/fetch-hanja.ts",
    "catalog:verify": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/verify-hanja.ts",
    "sazu:verify": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/verify-sazu.ts",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "catalog:import": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/import-catalog.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@sazuapp/client": "^0.10.1",
    "jose": "^6.2.14",
    "next": "^16.4.3",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
