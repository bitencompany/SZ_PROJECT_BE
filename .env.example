# 서버 전용. NEXT_PUBLIC_ 접두사 금지. 값은 Git/문서/메신저에 넣지 않습니다.
SAZU_API_KEY=
SUPABASE_URL=
# Supabase PostgreSQL transaction pooler URL (prepare:false). BE 전용 service_role 권한 연결.
# 스키마 생성 마이그레이션은 소유자 권한 연결로 별도 실행합니다. 원격 연결은 TLS 사용.
DATABASE_URL=
# FE BFF와 BE에 같은 32바이트 이상의 무작위 값. 브라우저에 공개하지 않습니다.
BFF_SHARED_SECRET=
# 입력/IP 해시용. BFF/작업 키와 다른 값을 사용하고 안정적으로 유지합니다.
INPUT_HASH_SECRET=
# 운영 작업 POST 호출용
WORKER_SECRET=
# Vercel Cron GET 호출용. Vercel이 Authorization: Bearer 헤더를 전달합니다.
CRON_SECRET=
# DB/키/FE 신뢰 IP 전달/동의 화면 검증 후에만 활성화
PREVIEW_ENABLED=false
SAZU_DAILY_CALL_BUDGET=100
# 모델 이름은 계정에서 검증한 버전으로 명시. 기본 모델/가격을 임의 설정하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_DAILY_CALL_BUDGET=50
# PG 계약 전: 실제 결제는 코드에서 비활성. PAYMENTS_ENABLED 같은 우회 설정 없음.
